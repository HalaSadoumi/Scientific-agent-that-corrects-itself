# Copy this file to .env for a local development configuration.
APP_ENV=dev

POSTGRES_USER=agent
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=agent
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
STORAGE_BACKEND=sqlite

REDIS_HOST=127.0.0.1
REDIS_PORT=6380

DATA_DIR=data
MAX_UPLOAD_BYTES=20971520
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
OCR_ENABLED=true
OCR_LANGUAGE=eng

OBJECT_STORAGE_BACKEND=local
S3_ENDPOINT=127.0.0.1:3900
S3_BUCKET=uploads
S3_REGION=garage
S3_ACCESS_KEY=GK00000000000000000000000000000000
S3_SECRET_KEY=dev-only-change-this-secret-before-sharing

# Optional OpenAI-compatible embedding endpoint.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_WEIGHT=0.5

# Optional OpenAI-compatible chat endpoint. Use two different model names.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
VERIFICATION_MODEL=
