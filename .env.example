# Copy this file to .env for a local development configuration.
APP_ENV=dev

POSTGRES_USER=agent
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=agent
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
STORAGE_BACKEND=sqlite

REDIS_HOST=127.0.0.1
REDIS_PORT=6380

DATA_DIR=data
MAX_UPLOAD_BYTES=20971520
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
OCR_ENABLED=true
OCR_LANGUAGE=eng

OBJECT_STORAGE_BACKEND=local
S3_ENDPOINT=127.0.0.1:3900
S3_BUCKET=uploads
S3_REGION=garage
S3_ACCESS_KEY=GK00000000000000000000000000000000
S3_SECRET_KEY=dev-only-change-this-secret-before-sharing

# Embeddings: none (keyword only), local (free AstroBERT), or api (hosted).
EMBEDDING_BACKEND=none
LOCAL_EMBEDDING_MODEL=NeuML/astrobert-small-embeddings

# Optional OpenAI-compatible embedding endpoint. Select EMBEDDING_BACKEND=api.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_WEIGHT=0.5

# Optional graph retrieval: use a Neo4j AuraDB Free instance or another Neo4j URI.
# Install the graph extra first: uv sync --extra graph
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional: full path to tesseract.exe if it is not on PATH (Windows).
# Example: TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=

# Gemini's native API base. The app sends its native GenerateContent request here.
# Use separate answer and verification models; free-tier quotas can vary.
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
VERIFICATION_MODEL=gemini-3.1-flash-lite
